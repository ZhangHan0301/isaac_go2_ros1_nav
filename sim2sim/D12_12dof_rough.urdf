  <contact>
    <exclude body1="base_link" body2="right_hip_roll_link"/>
    <exclude body1="right_hip_roll_link" body2="right_hip_yaw_link"/>
    <exclude body1="right_hip_yaw_link" body2="right_hip_pitch_link"/>
