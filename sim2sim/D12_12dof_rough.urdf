    <mesh name="left_ankle_pitch_link" file="left_ankle_pitch_link.STL"/>
    <mesh name="left_ankle_roll_link" file="left_ankle_roll_link.STL"/>

    <hfield name="hf0" nrow="200" ncol="200" size="10 5 0.2 0.1"/>
  </asset>

  <worldbody>
    <light directional="true" pos="0 0 5" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="0 100 0.1" pos="0 0 0" quat="1 0 0 0" material="matplane" condim="1" conaffinity="15"/>

    <!-- 添加台阶 10厘米  -->
    <body name="step1" pos="6 0 0.0">
