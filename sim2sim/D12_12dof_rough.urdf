    <actuatorvel name="left_ankle_pitch_joint_vel"  actuator="left_ankle_pitch_joint" user="13"/>
    <actuatorvel name="left_ankle_roll_joint_vel"  actuator="left_ankle_roll_joint" user="13"/>
    <actuatorvel name="right_hip_roll_joint_vel"  actuator="right_hip_roll_joint" user="13"/>
    <actuatorvel name="right_hip_yaw_joint_vel"  actuator="right_hip_yaw_joint" user="13"/>
    <actuatorvel name="right_hip_pitch_joint_vel"  actuator="right_hip_pitch_joint" user="13"/>
    <actuatorvel name="right_knee_pitch_joint_vel"  actuator="right_knee_pitch_joint" user="13"/>
    <actuatorvel name="right_ankle_pitch_joint_vel"  actuator="right_ankle_pitch_joint" user="13"/>
    <actuatorvel name="right_ankle_roll_joint_vel"  actuator="right_ankle_roll_joint" user="13"/>

    <actuatorfrc name="left_hip_roll_joint_frc"  actuator="left_hip_roll_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="left_hip_yaw_joint_frc"  actuator="left_hip_yaw_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="left_hip_pitch_joint_frc"  actuator="left_hip_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="left_knee_pitch_joint_frc"  actuator="left_knee_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="left_ankle_pitch_joint_frc"  actuator="left_ankle_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="left_ankle_roll_joint_frc"  actuator="left_ankle_roll_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_hip_roll_joint_frc"  actuator="right_hip_roll_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_hip_yaw_joint_frc"  actuator="right_hip_yaw_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_hip_pitch_joint_frc"  actuator="right_hip_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_knee_pitch_joint_frc"  actuator="right_knee_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_ankle_pitch_joint_frc"  actuator="right_ankle_pitch_joint" user="13" noise="1e-3"/>
    <actuatorfrc name="right_ankle_roll_joint_frc"  actuator="right_ankle_roll_joint" user="13" noise="1e-3"/>

    <framequat name="orientation" objtype="site" noise="0.001" objname="imu"/>
    <framepos name="position" objtype="site" noise="0.001" objname="imu"/>
    <gyro          name="angular_velocity"    site="imu" noise="0.005" cutoff="34.9"/>
    <velocimeter   name="linear_velocity"     site="imu" noise="0.001" cutoff="30"/>
    <accelerometer name="linear_acceleration" site="imu" noise="0.005" cutoff="157"/>
    <magnetometer  name="magnetometer"        site="imu"/>
    <!-- 手动展开配置 rangefinder 传感器 -->
    <rangefinder name="rangefinder_{x}_{y}" site="laser_{x}_{y}" cutoff="2.5"/>
  </sensor>

</mujoco>
