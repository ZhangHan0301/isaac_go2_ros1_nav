<mujoco model="D12_12dof">
  <compiler angle="radian" meshdir="../meshes/" eulerseq="zyx"/>
  <option timestep="0.001" iterations="50" solver="PGS" gravity="0 0 -9.81">
  <flag frictionloss="enable"/>
  </option>
  <size njmax="500" nconmax="100"/>
  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.7 0.7 0.7" specular="0.2 0.2 0.2"/>
    <quality shadowsize="4096"/>
    <map znear="0.05"/>
  </visual>

  <default>
    <joint limited="true"/>
    <motor ctrllimited="true"/>
    <geom  condim="4" contype="1" conaffinity="15" solref="0.001 2" friction="0.9 0.2 0.2"/>
    <equality solref="0.001 2"/>
    <default class="visualgeom">
      <geom material="visualgeom" condim="1" contype="0" conaffinity="0"/>
    </default>

    <default class="joint_param_0">
      <joint  damping="0.01" frictionloss="0.01" armature="0.01"/>
    </default> 
    <default class="joint_param_1">
      <joint  damping="2.0" frictionloss="0.01" armature="0.01"/>
    </default>
    <default class="joint_param_2">
      <joint  damping="1.0" frictionloss="0.01" armature="0.01"/>
    </default>
    <default class="joint_param_3">
      <joint  damping="0.01" frictionloss="0.01" armature="0.15"/>
    </default> 
    <default class="joint_param_4">
      <joint  damping="1.0" frictionloss="0.01" armature="0.04"/>
    </default> 
    <default class="joint_param_5">
      <joint  damping="0.01" frictionloss="0.01" armature="0.01"/>
    </default> 
    <default class="joint_param_6">
      <joint  damping="0.01" frictionloss="0.01" armature="0.10"/>
    </default> 
    <default class="joint_param_7">
      <joint  damping="2.0" frictionloss="0.01" armature="0.01"/>
    </default>
    <default class="joint_param_8">
      <joint  damping="1.0" frictionloss="0.01" armature="0.01"/>
    </default>
    <default class="joint_param_9">
      <joint  damping="0.01" frictionloss="0.01" armature="0.15"/>
    </default> 
    <default class="joint_param_10">
      <joint  damping="1.0" frictionloss="0.01" armature="0.04"/>
    </default> 
    <default class="joint_param_11">
      <joint  damping="0.01" frictionloss="0.01" armature="0.01"/>
    </default> 
  </default>

