  <asset>
    
    <texture name="skybox" type="skybox" builtin="gradient" rgb1="0.2 0.3 0.4" rgb2="0 0 0" width="1000" height="1000" mark="random" random="0.001" markrgb="1 1 1"/>
    <texture name="texplane" type="2d" builtin="checker" rgb1="0.2 0.3 0.4" rgb2="0.1 0.15 0.2" width="512" height="512" mark="cross" markrgb="0.8 0.8 0.8"/>

    <material name="matplane" reflectance="0" texture="texplane" texrepeat="1 1" texuniform="true"/>
    <material name="visualgeom"  rgba="0.79216 0.81961 0.93333 1"/>

    <mesh name="base_link" file="base_link.STL"/>
    <mesh name="right_hip_roll_link" file="right_hip_roll_link.STL"/>
    <mesh name="right_hip_yaw_link" file="right_hip_yaw_link.STL"/>
    <mesh name="right_hip_pitch_link" file="right_hip_pitch_link.STL"/>
    <mesh name="right_knee_pitch_link" file="right_knee_pitch_link.STL"/>
