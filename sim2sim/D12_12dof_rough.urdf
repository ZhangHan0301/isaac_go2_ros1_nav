      <site name="imu" size="0.01" pos="0.0 0.0 0.0"/>
      <!-- 添加17*11的激光阵列 -->
      <replicate count="17" offset="0.1 0 0">
        <replicate count="11" offset="0 0.1 0">
          <site name="laser_{x}_{y}" pos="-0.8 -0.5 0" zaxis="0 0 -1" size="0.01" rgba="1 0 0 1" group="2"/>
        </replicate>
      </replicate>

      <body name="left_hip_roll_link" pos="-0.0471723 0.1 -0.19">
