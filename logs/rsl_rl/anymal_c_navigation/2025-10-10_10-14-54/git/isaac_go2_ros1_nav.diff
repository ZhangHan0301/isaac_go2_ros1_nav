+# ===================== VecEnv 抽象基类 =====================
+class VecEnv(ABC):
+    def __init__(self):
+        self.num_envs = 0
+
+    @abstractmethod
+    def reset(self):
+        pass
+
+    @abstractmethod
+    def step_async(self, actions):
+        pass
+
+    @abstractmethod
+    def step_wait(self):
+        pass
+
+    def step(self, actions):
+        self.step_async(actions)
+        return self.step_wait()
+
+
+# ===================== RSL-RL 风格 VecEnv 封装 =====================
+class RslRlVecEnvWrapper(VecEnv):
+    """封装多个 CounterEnv，支持 episode_length_buf"""
+    def __init__(self, env_fns):
+        super().__init__()
+        self.envs = [fn() for fn in env_fns]
+        self.num_envs = len(self.envs)
+        self._actions = None
+
+    @property
+    def episode_length_buf(self):
+        # 返回所有 env 的 buffer
+        return np.array([env.episode_length_buf for env in self.envs])
+
+    @episode_length_buf.setter
+    def episode_length_buf(self, values: torch.Tensor):
+        # 支持批量写入
+        for env, val in zip(self.envs, values):
+            env.episode_length_buf = val.item()
+
+    def reset(self):
+        return np.array([env.reset() for env in self.envs])
+
+    def step_async(self, actions):
+        self._actions = actions
+
+    def step_wait(self):
+        obs, rewards, dones, infos = [], [], [], []
+        for env, action in zip(self.envs, self._actions):
+            o, r, d, i = env.step(action)
+            obs.append(o)
+            rewards.append(r)
+            dones.append(d)
+            infos.append(i)
+        return np.array(obs), np.array(rewards), np.array(dones), infos
+
+
