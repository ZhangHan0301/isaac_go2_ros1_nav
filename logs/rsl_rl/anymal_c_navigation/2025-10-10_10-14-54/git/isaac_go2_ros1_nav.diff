+import json
+@torch.no_grad()
+def height_scan_to_polar(
+    env: "ManagerBasedEnv",
+    sensor_cfg: "SceneEntityCfg",
+    num_sectors: int,
+    ground_threshold: float = 0.1,
+    default_value: float = 10.0,
+) -> torch.Tensor:
+    """
+    点云坐标变换时，只进行2D 的旋转，返回形状: (num_env, N)，每环境每扇区的最小 r；若该扇区无点，则为 default_value
+    """
+    torch.set_printoptions(precision=3,sci_mode=False) 
+    sensor:RayCaster = env.scene.sensors[sensor_cfg.name]
+    cloud_points_w = sensor.data.ray_hits_w
+    robot_pos_w  = sensor.data.pos_w
+    robot_quat_w = sensor.data.quat_w
+    
+    data_to_save = {
+        "points_w": cloud_points_w.cpu().tolist(),
+        "pos_w": robot_pos_w.cpu().tolist(),
+        "quat_w": robot_quat_w.cpu().tolist()
+    }
+    
+    # （可选）数值稳健：若不保证单位四元数，可启用这两行
+    robot_quat_w = robot_quat_w / robot_quat_w.norm(dim=-1, keepdim=True).clamp_min(1e-12)
+
+        # --- 地面过滤（在局部系） ---
+    valid = cloud_points_w[..., 2] > ground_threshold         
+    cloud_points_w_valid = cloud_points_w[valid]
+    
+    cloud_point_w_xy = cloud_points_w_valid[:,:2]
+    robot_pos_w_xy = robot_pos_w[:,:2]
+    print("cloud points w ", cloud_points_w)
+    print("cloud_points_w_valid ", cloud_points_w_valid)
+    # --- 世界 -> 局部（一次性批量） ---
+    # 计算旋转矩阵
+    w, x, y, z = robot_quat_w.unbind(dim=-1) 
+    yaw = torch.atan2(2.0 * (w * z + x * y), 1.0 - 2.0 * (y * y + z * z))
+    print("yaw ", yaw)  
+    Rxx = 1 - 2*(y*y + z*z)
+    Rxy = 2*(x*y - w*z)
+    Ryx = 2*(x*y + w*z)
+    Ryy = 1 - 2*(x*x + z*z)
+    # [env_nums, 2, 2]
+    R_World2Robot = torch.stack([torch.stack([Rxx, Rxy], dim=-1),
+                     torch.stack([Ryx, Ryy], dim=-1)], dim=-2) 
+    print("R ", R_World2Robot)
+    #世界坐标系 -> 以机器人为原点的坐标（先平移后旋转）
+    rel_w = cloud_point_w_xy - robot_pos_w_xy.unsqueeze(1)     # 世界坐标系下相对位置 
+    # 逆旋转（单位四元数逆 = 共轭）
+    cloud_point_robot = torch.matmul(rel_w, R_World2Robot)
+    print("robot pose xy ", robot_pos_w)
+    print("robot quat ",robot_quat_w)
+    print("cloud point in robot link ", cloud_point_robot)
+    # --- 转换到极坐标 ---
+    xy = cloud_point_robot                               # (E, R, 2)
+    radius = torch.linalg.norm(xy, dim=-1)                    # (E, R)
+    theta = torch.atan2(xy[..., 1], xy[..., 0])          # (E, R)
+    theta = (theta + 2 * math.pi) % (2 * math.pi)        # [0, 2π)
+    sector_angle = 2 * math.pi / num_sectors
+    sectors = (theta / sector_angle).floor().clamp_(max=num_sectors-1).long()  # (E, R)
+    #  ---------- 每个扇区最小距离 ----------
+    # 用 scatter_reduce 更高效；老版本无此 API 时回退到循环
+    env_nums = sectors.size(0)
+    radius_min = torch.full((env_nums,num_sectors), float(default_value)).cuda()
+    if hasattr(radius_min, "scatter_reduce"):
+        # print("sectors indx ", sectors)
+        # print("radius ", radius)
+        radius_min = radius_min.scatter_reduce(1, sectors, radius, reduce="amin", include_self=True)
+        print(" radius_min ", radius_min) 
+    return radius_min
+
+@torch.no_grad()
+def height_scan_to_polar_3d(
+    env: "ManagerBasedEnv",
+    sensor_cfg: "SceneEntityCfg",
+    num_sectors: int,
+    ground_threshold: float = 0.1,
+    default_value: float = 10.0,
+) -> torch.Tensor:
+    """
+    返回形状: (num_env, N)，每环境每扇区的最小 r；若该扇区无点，则为 default_value
+    """
+    sensor:RayCaster = env.scene.sensors[sensor_cfg.name]
+    cloud_points_w = sensor.data.ray_hits_w
+    robot_pos_w  = sensor.data.pos_w
+    robot_quat_w = sensor.data.quat_w
+    
+    data_to_save = {
+        "points_w": cloud_points_w.cpu().tolist(),
+        "pos_w": robot_pos_w.cpu().tolist(),
+        "quat_w": robot_quat_w.cpu().tolist()
+    }
+    # 保存到 JSON 文件
+    with open("/home/nav/isaac_new/isaac_go2_ros1_nav/data/lidar_data.json", "w") as f:
+        json.dump(data_to_save, f)
+
+    # （可选）数值稳健：若不保证单位四元数，可启用这两行
+    robot_quat_w = robot_quat_w / robot_quat_w.norm(dim=-1, keepdim=True).clamp_min(1e-12)
+    # 2) 四元数 -> 3x3 旋转矩阵（body→world）
+    # 采用常用右手系、单位四元数 (w,x,y,z) 到旋转矩阵的公式
+    w, x, y, z = robot_quat_w.unbind(dim=-1)   
+    Rxx = 1 - 2*(y*y + z*z)
+    Rxy = 2*(x*y - w*z)
+    Rxz = 2*(x*z + w*y)
+
+    Ryx = 2*(x*y + w*z)
+    Ryy = 1 - 2*(x*x + z*z)
+    Ryz = 2*(y*z - w*x)
+
+    Rzx = 2*(x*z - w*y)
+    Rzy = 2*(y*z + w*x)
+    Rzz = 1 - 2*(x*x + y*y)
+
+    R_body2world = torch.stack([
+        torch.stack([Rxx, Rxy, Rxz], dim=-1),
+        torch.stack([Ryx, Ryy, Ryz], dim=-1),
+        torch.stack([Rzx, Rzy, Rzz], dim=-1)
+    ], dim=-2)                                                     # [E, 3, 3]
+
+    # 3) world→body 需要转置（正交矩阵的逆 = 转置）
+    R_world2body = R_body2world.transpose(-1, -2)                  # [E, 3, 3]
+
+    # 4) 世界点 -> 以机器人为原点/机体系的坐标（先平移后旋转）
+    rel_w = cloud_points_w - robot_pos_w.unsqueeze(1)              # [E, N, 3]
+    cloud_points_body = torch.matmul(rel_w, R_world2body)  
+
+            # --- 地面过滤（在局部系） ---
+    valid = cloud_points_body[..., 2] > ground_threshold         
+    cloud_points_body_valid = cloud_points_body[valid]    
+    print("cloud point in base link ", cloud_points_body_valid)
+
+    # --- 转换到极坐标 ---
+    xy = cloud_points_body_valid[:,:2]                               # (E, R, 2)
+    radius = torch.linalg.norm(xy, dim=-1)                    # (E, R)
+    theta = torch.atan2(xy[..., 1], xy[..., 0])          # (E, R)
+    theta = (theta + 2 * math.pi) % (2 * math.pi)        # [0, 2π)
+    sector_angle = 2 * math.pi / num_sectors
+    sectors = (theta / sector_angle).floor().clamp_(max=num_sectors-1).long()  # (E, R)
+    #  ---------- 每个扇区最小距离 ----------
+    # 用 scatter_reduce 更高效；老版本无此 API 时回退到循环
+    radius_min = torch.full((num_sectors,), float(default_value)).cuda()
+    if hasattr(radius_min, "scatter_reduce"):
+        radius_min = radius_min.scatter_reduce(0, sectors, radius, reduce="amin", include_self=True)
+
+    return radius_min
+
+
+def lidar_distance_scan_horizontal(env: ManagerBasedEnv, sensor_cfg: SceneEntityCfg) -> torch.Tensor:
+    """返回360维水平距离信息（忽略高度差）"""
+    sensor: RayCaster = env.scene.sensors[sensor_cfg.name]
+    
+    sensor_pos = sensor.data.pos_w  # [num_envs, 3]
+    hit_points = sensor.data.ray_hits_w  # [num_envs, num_rays, 3]
+    
+    # 只计算水平距离：sqrt((x2-x1)^2 + (y2-y1)^2)
+    horizontal_diff = hit_points[..., :2] - sensor_pos[..., :2].unsqueeze(1)
+    distances = torch.norm(horizontal_diff, dim=2)
+    
+    # 限制最大距离为3m
+    distances = torch.clamp(distances,min=0.0, max=3.0)
+    # print(distances)
+    
+    return distances  # 形状: [num_envs, 360]
